# Keep local secrets out of commits while allowing safe example files.
.env
.env.*
!.env.example
!**/.env.example

# Keep installed packages and generated local data out of the repository.
node_modules/
**/node_modules/
backend/uploads/
uploads/
coverage/
dist/
.cache/

# Ignore local logs and operating-system files.
*.log
npm-debug.log*
.DS_Store
Thumbs.db
desktop.ini

