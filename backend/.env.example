# Copy this file to .env and replace the placeholder with your PostgreSQL password.
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/taskflow
JWT_SECRET=replace_with_a_long_random_secret
PORT=3000
NODE_ENV=development
GEMINI_API_KEY=replace_with_your_gemini_api_key
AI_MODEL=gemini-3.8-flash
