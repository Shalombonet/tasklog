# Copy this file to backend/.env and replace every placeholder with your own settings.
# For Neon, paste the full connection string from the Neon dashboard; it must end in ?sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Use a long, private random value. Never use the example text as a real key.
JWT_SECRET=replace_with_a_long_random_secret
# Render sets PORT automatically; 3000 is the local development fallback.
PORT=3000
NODE_ENV=development
# Leave blank to keep AI step suggestions gracefully unavailable.
GEMINI_API_KEY=
# Current Flash model configured by this project.
AI_MODEL=gemini-3.8-flash
# Seeding is blocked unless you temporarily change this to true for one command.
ALLOW_SEED=false
